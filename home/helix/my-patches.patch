+#[derive(Debug, Clone, Default)]
+pub struct Breadcrumbs(Vec<Crumb>);
+
+impl Breadcrumbs {
+    #[inline]
+    pub fn push(&mut self, crumb: Crumb) {
+        self.0.push(crumb);
+    }
