From 00af9b04fcedf5546b02da0b02ba6c3775921f7a Mon Sep 17 00:00:00 2001
From: feafel <feafel@example.com>
Date: Thu, 5 Nov 2026 04:13:13 +0700
Subject: [PATCH 04/15] transaction: sort deletions before merging

Transaction::delete merges overlapping ranges while walking them, but it
only prevented ranges whose end was before the previous range's end from
being dropped. Callers may pass ranges in any order, and unsorted ranges
were silently skipped.

Collect and sort the ranges by start before merging. Add a regression
test with two unsorted, non-overlapping ranges.

Signed-off-by: Awiteb <a@4rs.nl>
---
 helix-core/src/transaction.rs | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/helix-core/src/transaction.rs b/helix-core/src/transaction.rs
index ea52b4e3b..21e792b2f 100644
--- a/helix-core/src/transaction.rs
+++ b/helix-core/src/transaction.rs
@@ -673,9 +673,13 @@ pub fn delete<I>(doc: &Rope, deletions: I) -> Self
     {
         let len = doc.len_chars();
 
-        let (lower, upper) = deletions.size_hint();
-        let size = upper.unwrap_or(lower);
-        let mut changeset = ChangeSet::with_capacity(2 * size + 1); // rough estimate
+        // The merge below relies on ranges sorted by start; callers are not
+        // required to provide them in order, and unsorted ranges used to be
+        // dropped silently.
+        let mut deletions: Vec<Deletion> = deletions.collect();
+        deletions.sort_unstable_by_key(|&(from, _)| from);
+
+        let mut changeset = ChangeSet::with_capacity(2 * deletions.len() + 1); // rough estimate
 
         let mut last = 0;
         for (mut from, to) in deletions {
@@ -936,6 +940,16 @@ mod test {
     use super::*;
     use crate::history::State;
 
+    #[test]
+    fn delete_unsorted_ranges() {
+        let doc = Rope::from("abcd");
+        let transaction = Transaction::delete(&doc, vec![(2, 3), (0, 1)].into_iter());
+
+        let mut doc = doc;
+        assert!(transaction.apply(&mut doc));
+        assert_eq!(doc, "bd");
+    }
+
     #[test]
     fn composition() {
         use Operation::*;
