From 653a68b67c99fb8fa4bef411695d53a2a6aeb36b Mon Sep 17 00:00:00 2001
From: Awiteb <a@4rs.nl>
Date: Wed, 18 Nov 2026 21:09:43 +0000
Subject: [PATCH] bufferline: fix padding

Signed-off-by: Awiteb <a@4rs.nl>
---
 helix-term/src/ui/editor.rs | 41 ++++++++++++++++++-------------------
 helix-view/src/icons.rs     | 10 +++++++++
 2 files changed, 30 insertions(+), 21 deletions(-)

diff --git a/helix-term/src/ui/editor.rs b/helix-term/src/ui/editor.rs
index 9d2fc0888..bca0013f5 100644
--- a/helix-term/src/ui/editor.rs
+++ b/helix-term/src/ui/editor.rs
@@ -735,7 +735,7 @@ pub fn render_bufferline(editor: &Editor, viewport: Rect, surface: &mut Surface)
                         .set_stringn(
                             x,
                             viewport.y,
-                            &icon.glyph(),
+                            &icon.with_padding_left(0).glyph(),
                             remaining as usize,
                             icon.style(),
                         )
@@ -747,38 +747,37 @@ pub fn render_bufferline(editor: &Editor, viewport: Rect, surface: &mut Surface)
                 }
             }
 
+            // If it is modified, add the indicator, otherwise empty string
+            let modified = icons.ui().indicator().modified().with_no_padding().glyph();
+            let modification_indicator = if doc.is_modified() {
+                modified.as_str()
+            } else {
+                " "
+            };
+
             // PERF:
             // Rather than using `format!{"{name} "}`, we can save an allocation.
-            for element in [name, " "] {
+            for (idx, element) in [name, modification_indicator, "  "].iter().enumerate() {
                 let used = viewport.x.saturating_sub(x);
                 let remaining = surface.area.width.saturating_sub(used);
 
+                // Style for the modification indicator
+                let style = if idx == 1 {
+                    theme
+                        .try_get_exact("ui.statusline.file-modification-indicator")
+                        .unwrap_or(base)
+                } else {
+                    base
+                };
+
                 x = surface
-                    .set_stringn(x, viewport.y, element, remaining as usize, base)
+                    .set_stringn(x, viewport.y, element, remaining as usize, style)
                     .0;
 
                 if x >= surface.area.right() {
                     break;
                 }
             }
-
-            if doc.is_modified() {
-                let modified = icons.ui().indicator().modified();
-                // PERF:
-                // Rather than using `format!{"{name} "}`, we can save an allocation.
-                for element in [modified.glyph().as_str(), " "] {
-                    let used = viewport.x.saturating_sub(x);
-                    let remaining = surface.area.width.saturating_sub(used);
-
-                    x = surface
-                        .set_stringn(x, viewport.y, element, remaining as usize, base)
-                        .0;
-
-                    if x >= surface.area.right() {
-                        break;
-                    }
-                }
-            }
         }
     }
 
diff --git a/helix-view/src/icons.rs b/helix-view/src/icons.rs
index a84a612df..dab4dc4ea 100644
--- a/helix-view/src/icons.rs
+++ b/helix-view/src/icons.rs
@@ -200,6 +200,16 @@ pub const fn with_padding(mut self, left: u8, right: u8) -> Self {
         self
     }
 
+    #[inline]
+    #[must_use]
+    pub fn with_padding_left(mut self, left: u8) -> Self {
+        self.padding = Some(Padding {
+            left,
+            right: self.padding.map(|p| p.right).unwrap_or_default(),
+        });
+        self
+    }
+
     #[inline]
     #[must_use]
     pub const fn with_no_padding(self) -> Self {

