From 08757f1cfdbea95d3149e62fb0c73babc05ce39c Mon Sep 17 00:00:00 2001
From: Awiteb <a@4rs.nl>
Date: Wed, 18 Nov 2026 19:50:51 +0000
Subject: [PATCH] feat: add icons to breadcrumb navigation bar

Based-on: https://github.com/RoloEdits/helix/commit/fbf1e42689d53fd42e789461dcd063516b05ec27
Co-authored-by: Rolo <RoloEdits@gmail.com>
Signed-off-by: Awiteb <a@4rs.nl>
---
 helix-term/src/ui/editor.rs | 49 ++++++++++++++++++++++++++++++++++---
 helix-view/src/icons.rs     |  4 +--
 2 files changed, 48 insertions(+), 5 deletions(-)

diff --git a/helix-term/src/ui/editor.rs b/helix-term/src/ui/editor.rs
index 9ea966259..9d2fc0888 100644
--- a/helix-term/src/ui/editor.rs
+++ b/helix-term/src/ui/editor.rs
@@ -23,6 +23,7 @@
     visual_offset_from_block, Change, Position, Range, Selection, Transaction,
 };
 use helix_lsp::lsp::SymbolKind;
+use helix_stdx::stack_format;
 use helix_view::{
     annotations::diagnostics::DiagnosticFilter,
     document::{Mode, SCRATCH_BUFFER_NAME},
@@ -807,7 +808,8 @@ fn draw_element(
         }
 
         let config = editor.config();
-
+        let theme = editor.theme.as_ref();
+        let icons = ICONS.load();
         let style = editor
             .theme
             .try_get_exact("ui.breadcrumb")
@@ -849,6 +851,33 @@ fn draw_element(
                     let segment = component.as_os_str().to_string_lossy();
                     let is_directory = components.peek().is_some();
 
+                    if !is_directory {
+                        if let Some(icon) = icons
+                            .fs()
+                            .file()
+                            .and_then(|files| files.get(segment.as_ref()))
+                        {
+                            let style = theme
+                                .try_get_exact(format!("icons.file.{segment}").as_str())
+                                .or_else(|| {
+                                    path.extension().map(|ext| ext.display()).and_then(|ext| {
+                                        theme.try_get_exact(
+                                            stack_format!("icons.file.{ext}").as_str(),
+                                        )
+                                    })
+                                })
+                                .unwrap_or_else(|| icon.style());
+
+                            x = draw_element(
+                                surface,
+                                viewport,
+                                x,
+                                icon.with_padding(0, 2).glyph().as_str(),
+                                style,
+                            );
+                        }
+                    }
+
                     let style = if is_directory {
                         editor.theme.get("ui.text.directory")
                     } else {
@@ -869,7 +898,7 @@ fn draw_element(
                     draw_separator = true;
                 }
 
-                let style = match symbol.kind {
+                let symbol_style = match symbol.kind {
                     SymbolKind::MODULE
                     | SymbolKind::NAMESPACE
                     | SymbolKind::PACKAGE => editor.theme.get("namespace"),
@@ -902,7 +931,21 @@ fn draw_element(
                     _ => style,
                 };
 
-                x = draw_element(surface, viewport, x, symbol.name.as_ref(), style);
+                let kind = symbol.kind.as_str();
+                let icon_style = editor
+                    .theme
+                    .try_get_exact(stack_format!("icons.kind.{kind}").as_str())
+                    .unwrap_or(symbol_style);
+                if let Some(icon) = icons.kind().get(kind) {
+                    x = draw_element(
+                        surface,
+                        viewport,
+                        x,
+                        icon.with_padding(0, 2).glyph().as_str(),
+                        icon_style,
+                    );
+                }
+                x = draw_element(surface, viewport, x, symbol.name.as_ref(), symbol_style);
             }
         }
     }
diff --git a/helix-view/src/icons.rs b/helix-view/src/icons.rs
index 323cb2eeb..a84a612df 100644
--- a/helix-view/src/icons.rs
+++ b/helix-view/src/icons.rs
@@ -1648,8 +1648,8 @@ pub fn readonly(&self) -> Icon {
     #[inline]
     #[must_use]
     pub fn modified(&self) -> Icon {
-        // TODO: ●?
-        self.modified.unwrap_or_else(|| icon!("[+]"))
+        self.modified
+            .unwrap_or_else(|| icon!(glyph: "●", padding: [1, 1]))
     }
 
     #[inline]

