layout {
    pane {
        pane
    }

    pane size=1 borderless=true {
        plugin location="zjstatus" {
            format_left "#[fg=#4b4e5d,bg=#b1bbfa,blod] {command_ram} #[fg=#1b1f37,bg=#b1bbfa,bold]{command_cpu} #[fg=#4b4e5d,bg=#b1bbfa,blod]{command_gpu} #[fg=#1b1f37,bg=#b1bbfa,bold]{command_disk}#[fg=#b1bbfa,bg=#181825]"
            format_center "{tabs}"
            format_right "#[fg=#181825,bg=#b1bbfa]{datetime}"
            format_space "#[bg=#181825]"

            tab_normal              "#[fg=#181825,bg=#4C4C59] #[fg=#000000,bg=#4C4C59]{index} #[fg=#4C4C59,bg=#181825]"
            tab_normal_fullscreen   "#[fg=#4b4e5d,bg=#181825] {index}"
            tab_normal_sync         "#[fg=#4b4e5d,bg=#181825] {index}"
            tab_active              "#[fg=#181825,bg=#ffffff,bold,italic] {index} #[fg=#ffffff,bg=#181825]"
            tab_active_fullscreen   "#[fg=#9399B2,bg=#181825,bold,italic] {index}"
            tab_active_sync         "#[fg=#9399B2,bg=#181825,bold,italic] {index}"

            command_ram_command "ram_info.sh"
            command_ram_interval "3"
            command_ram_rendermode "raw"

            command_cpu_command "cpu_info.sh"
            command_cpu_interval "3"
            command_cpu_rendermode "raw"

            command_gpu_command "gpu_info.sh"
            command_gpu_interval "10"
            command_gpu_rendermode "raw"

            command_disk_command "disk_info.sh"
            command_disk_interval "10"
            command_disk_rendermode "raw"

            datetime          "#[fg=#4b4e5d,bg=#b1bbfa,bold] {format} "
            datetime_format   " %a %b %d  %I:%M %p"
            datetime_timezone "Asia/Riyadh"
        }
    }
}

