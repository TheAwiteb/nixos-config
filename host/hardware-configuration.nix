# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "thunderbolt"
    "vmd"
    "ahci"
    "nvme"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/a2b521d2-1c23-415d-bf6f-11828ac0ee2e";
    fsType = "ext4";
  };

  boot.initrd.luks.devices."luks-ee06cc22-f1e3-4e5f-941f-1c13179ea7ce".device =
    "/dev/disk/by-uuid/ee06cc22-f1e3-4e5f-941f-1c13179ea7ce";

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/6785-E8F0";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  # Backup storage, prepped for cloud synchronization :)
  fileSystems."/home/awiteb/backup" = {
    device = "/dev/disk/by-uuid/5f4db8c6-d26c-46ba-812e-1f0989552b52";
    fsType = "ext4";
  };

  # My VPS backup
  fileSystems."/home/awiteb/vps-backup" = {
    device = "/dev/disk/by-uuid/756fd314-7090-4ada-b21d-36268f3ae10a";
    fsType = "ext4";
  };

  swapDevices = [
    { device = "/dev/disk/by-uuid/03abd1a1-4a32-4d02-8267-933775b732cd"; }
  ];

  # Enables DHCP on each ethernet and wireless interface. In case of scripted networking
  # (the default) this is the recommended approach. When using systemd-networkd it's
  # still possible to use this option, but it's recommended to use it in conjunction
  # with explicit per-interface declarations with `networking.interfaces.<interface>.useDHCP`.
  networking.useDHCP = lib.mkDefault true;
  # networking.interfaces.enp43s0.useDHCP = lib.mkDefault true;
  # networking.interfaces.wlp0s20f3.useDHCP = lib.mkDefault true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
